{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "PaperWhirl",
  "version": "0.1.3",
  "identifier": "com.paperwhirl.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build && bash src-tauri/scripts/bundle_python.sh"
  },
  "app": {
    "windows": [
      {
        "title": "PaperWhirl",
        "width": 1400,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
